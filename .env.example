# Copia este archivo como .env.local y pon tus claves (.env.local NO se sube a git).
# Luego: npm run voces -- --sample   (prueba con 3 frases)
#        npm run voces               (genera todas las que falten)

VOICE_PROVIDER=edge

# Edge TTS (gratis, sin cuenta). Requiere: python -m pip install edge-tts
EDGE_VOICE=es-SV-LorenaNeural
EDGE_PITCH=+8Hz
EDGE_RATE=-4%

# Microsoft Azure (recurso "Speech" / "Voz")
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_VOICE=es-SV-LorenaNeural
AZURE_PITCH=+8%
AZURE_RATE=-4%

# ElevenLabs (si prefieres este servicio)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
